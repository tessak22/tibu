{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tibu.example/schemas/theme.schema.json",
  "title": "Tibu theme",
  "description": "themes/<id>/theme.json. The id must match the folder name. World is 24 x 16 x 24; ground layers fill y = 0 .. ground.length - 1, so the scene starts at y = ground.length.",
  "type": "object",
  "required": [
    "id",
    "name",
    "sky",
    "island",
    "ground",
    "scene"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "order": {
      "type": "number"
    },
    "icon": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.(png|jpg|jpeg|webp|svg)$",
      "description": "Optional picture in the theme folder. Generated when omitted."
    },
    "sky": {
      "type": "object",
      "required": [
        "top",
        "bottom"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/definitions/color"
        },
        "bottom": {
          "$ref": "#/definitions/color"
        },
        "stars": {
          "type": "boolean"
        }
      }
    },
    "island": {
      "type": "object",
      "required": [
        "shape",
        "depth"
      ],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "round",
            "square",
            "blob"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "ground": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/blockKey"
      }
    },
    "cloudColor": {
      "$ref": "#/definitions/color"
    },
    "scene": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
    },
    "blockKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "coord": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/coord"
      }
    },
    "entry": {
      "description": "A single cell {x,y,z,block} or an inclusive box {from,to,block}.",
      "type": "object",
      "if": {
        "required": [
          "from"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "from",
          "to",
          "block"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "$ref": "#/definitions/point"
          },
          "to": {
            "$ref": "#/definitions/point"
          },
          "block": {
            "$ref": "#/definitions/blockKey"
          }
        }
      },
      "else": {
        "type": "object",
        "required": [
          "x",
          "y",
          "z",
          "block"
        ],
        "additionalProperties": false,
        "properties": {
          "x": {
            "$ref": "#/definitions/coord"
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "z": {
            "$ref": "#/definitions/coord"
          },
          "block": {
            "$ref": "#/definitions/blockKey"
          }
        }
      }
    }
  }
}
