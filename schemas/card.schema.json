{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tibu.example/schemas/card.schema.json",
  "title": "Tibu build card",
  "description": "cards/<id>.json. The id must match the file name. Cells are relative to the card's own origin; matching ignores position and allows 90 degree turns.",
  "type": "object",
  "required": [
    "id",
    "name",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "order": {
      "type": "number"
    },
    "mode": {
      "enum": [
        "little",
        "big"
      ],
      "description": "Which play mode shows this card. Missing means 'little'."
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "blockKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "coord": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/coord"
      }
    },
    "entry": {
      "description": "A single cell {x,y,z,block} or an inclusive box {from,to,block}.",
      "type": "object",
      "if": {
        "required": [
          "from"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "from",
          "to",
          "block"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "$ref": "#/definitions/point"
          },
          "to": {
            "$ref": "#/definitions/point"
          },
          "block": {
            "$ref": "#/definitions/blockKey"
          }
        }
      },
      "else": {
        "type": "object",
        "required": [
          "x",
          "y",
          "z",
          "block"
        ],
        "additionalProperties": false,
        "properties": {
          "x": {
            "$ref": "#/definitions/coord"
          },
          "y": {
            "$ref": "#/definitions/coord"
          },
          "z": {
            "$ref": "#/definitions/coord"
          },
          "block": {
            "$ref": "#/definitions/blockKey"
          }
        }
      }
    }
  }
}
