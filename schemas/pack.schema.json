{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tibu.example/schemas/pack.schema.json",
  "title": "Tibu block pack",
  "description": "packs/<id>/pack.json. The id must match the folder name. Image paths are relative to the pack folder and live in icons/; audio paths live in audio/.",
  "type": "object",
  "required": [
    "id",
    "name",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "English name, spoken when the pack is chosen."
    },
    "order": {
      "type": "number",
      "description": "Sort order in the pack picker (lower first)."
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "icon": {
      "description": "Pack picker icon: one of the pack's blocks, or any face art.",
      "type": "object",
      "if": {
        "required": [
          "block"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "block"
        ],
        "additionalProperties": false,
        "properties": {
          "block": {
            "$ref": "#/definitions/id"
          }
        }
      },
      "else": {
        "$ref": "#/definitions/art"
      }
    },
    "tileColor": {
      "$ref": "#/definitions/color",
      "description": "Background of the pack picker tile."
    },
    "mode": {
      "enum": [
        "little",
        "big"
      ],
      "description": "Only offer this pack in one play mode ('big' = big-kid mode). Missing means every mode."
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/definitions/block"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$"
    },
    "imagePath": {
      "type": "string",
      "pattern": "^icons/[A-Za-z0-9_./-]+\\.(png|jpg|jpeg|webp|svg)$"
    },
    "audioPath": {
      "type": "string",
      "pattern": "^audio/[A-Za-z0-9_./-]+\\.(mp3|ogg|wav|m4a|webm)$"
    },
    "mark": {
      "enum": [
        "circle",
        "square",
        "rectangle",
        "triangle",
        "star",
        "heart",
        "diamond",
        "oval",
        "moon",
        "hexagon",
        "pentagon",
        "cross",
        "cloud",
        "drop",
        "flower",
        "ring"
      ]
    },
    "pattern": {
      "enum": [
        "dots",
        "stripes",
        "checker",
        "noise",
        "glyph",
        "dots-count",
        "note",
        "spots",
        "fluffy",
        "grass",
        "dirt",
        "sand",
        "water-waves",
        "wood-grain",
        "wood-rings",
        "leaves",
        "flowers",
        "stone",
        "snow",
        "ice",
        "craters",
        "hay",
        "bricks",
        "planks",
        "window",
        "door",
        "roof",
        "glass",
        "lamp",
        "star-shape",
        "animal-face"
      ]
    },
    "synthPreset": {
      "description": "Synth presets implemented by src/audio. 'note' takes a MIDI note number.",
      "enum": [
        "moo",
        "baa",
        "oink",
        "neigh",
        "cluck",
        "quack",
        "meow",
        "woof",
        "tweet",
        "ribbit",
        "squeak",
        "note",
        "chime",
        "pop",
        "splash",
        "rustle",
        "knock",
        "ding"
      ]
    },
    "animal": {
      "enum": [
        "cow",
        "pig",
        "sheep",
        "horse",
        "chicken",
        "duck",
        "cat",
        "dog",
        "bird",
        "frog",
        "mouse",
        "bunny"
      ]
    },
    "behavior": {
      "enum": [
        "speak",
        "sound",
        "bounce",
        "glow"
      ]
    },
    "solidArt": {
      "type": "object",
      "required": [
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/definitions/color"
        },
        "mark": {
          "$ref": "#/definitions/mark"
        },
        "markColor": {
          "$ref": "#/definitions/color"
        },
        "markSize": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.9
        }
      }
    },
    "patternArt": {
      "type": "object",
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "$ref": "#/definitions/pattern"
        },
        "color": {
          "$ref": "#/definitions/color"
        },
        "accent": {
          "$ref": "#/definitions/color"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "glyph"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "dots-count"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "required": [
                  "count"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "animal-face"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "required": [
                  "animal"
                ],
                "properties": {
                  "animal": {
                    "$ref": "#/definitions/animal"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "note"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2
                  }
                }
              }
            }
          }
        }
      ]
    },
    "imageArt": {
      "type": "object",
      "required": [
        "image"
      ],
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/imagePath"
        }
      }
    },
    "art": {
      "description": "Face art. 'pattern' picks a generated pattern, 'image' a picture in icons/, otherwise a solid 'color' with an optional mark.",
      "type": "object",
      "if": {
        "required": [
          "pattern"
        ]
      },
      "then": {
        "$ref": "#/definitions/patternArt"
      },
      "else": {
        "if": {
          "required": [
            "image"
          ]
        },
        "then": {
          "$ref": "#/definitions/imageArt"
        },
        "else": {
          "$ref": "#/definitions/solidArt"
        }
      }
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "top": {
          "$ref": "#/definitions/art"
        },
        "side": {
          "$ref": "#/definitions/art"
        },
        "bottom": {
          "$ref": "#/definitions/art"
        }
      }
    },
    "sound": {
      "type": "object",
      "if": {
        "required": [
          "file"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "$ref": "#/definitions/audioPath"
          }
        }
      },
      "else": {
        "type": "object",
        "required": [
          "synth"
        ],
        "additionalProperties": false,
        "properties": {
          "synth": {
            "$ref": "#/definitions/synthPreset"
          },
          "note": {
            "type": "integer",
            "minimum": 21,
            "maximum": 108,
            "description": "MIDI note number (60 = middle C)."
          }
        },
        "if": {
          "properties": {
            "synth": {
              "const": "note"
            }
          },
          "required": [
            "synth"
          ]
        },
        "then": {
          "required": [
            "note"
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "name",
        "art"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Spoken English name."
        },
        "art": {
          "$ref": "#/definitions/art",
          "description": "Default art for every face."
        },
        "faces": {
          "$ref": "#/definitions/faces",
          "description": "Optional per-face overrides; 'side' covers the four sides."
        },
        "sound": {
          "$ref": "#/definitions/sound",
          "description": "Played when tapped (needs the 'sound' behavior)."
        },
        "behaviors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/behavior"
          }
        },
        "glowColor": {
          "$ref": "#/definitions/color",
          "description": "Light color for the 'glow' behavior. Defaults to the art color."
        },
        "shape": {
          "$ref": "#/definitions/shape",
          "description": "Geometry of the block. Defaults to 'cube'."
        }
      }
    },
    "shape": {
      "enum": [
        "cube",
        "slope",
        "slab",
        "plate",
        "wheel",
        "cone",
        "arch",
        "pane",
        "cylinder"
      ],
      "description": "Block geometry. Non-cube shapes are 'parts' and turn with the camera when placed."
    }
  }
}
