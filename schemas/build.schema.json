{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tibu.example/schemas/build.schema.json",
  "title": "Tibu step-by-step build (blueprint)",
  "description": "builds/<id>.json. The id must match the file name. Big-kid mode shows one step at a time as see-through ghost blocks. Cells are relative to an anchor the app picks; y=0 sits on the ground. Builds fit in 8x8x8 and have at most 80 blocks. Every block must rest on the ground, or on (or beside) a block from an earlier or the same step.",
  "type": "object",
  "required": [
    "id",
    "name",
    "difficulty",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Spoken English name, e.g. \"house\". Also used for \"You built a house!\"."
    },
    "order": {
      "type": "number",
      "description": "Sort order in the build picker (lower first)."
    },
    "difficulty": {
      "enum": [
        1,
        2,
        3
      ],
      "description": "1 = easy (any block from the same pack counts), 2 and 3 = the exact block is needed."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "blocks"
        ],
        "additionalProperties": false,
        "properties": {
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/definitions/block"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "blockKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "coord": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "block": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z",
        "block"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/definitions/coord"
        },
        "y": {
          "$ref": "#/definitions/coord"
        },
        "z": {
          "$ref": "#/definitions/coord"
        },
        "block": {
          "$ref": "#/definitions/blockKey"
        },
        "rot": {
          "enum": [
            0,
            1,
            2,
            3
          ],
          "description": "Quarter turns about the vertical axis (for parts such as roof slopes)."
        }
      }
    }
  }
}
